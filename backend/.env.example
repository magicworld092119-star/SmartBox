# Environment mode: development or production
ENVIRONMENT=production

# Strong random secret key for JWT (Required in production)
SECRET_KEY=generate_a_random_32_character_secret_here

# Access token expiry in minutes (e.g. 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Admin credentials
ADMIN_EMAIL=admin@smartbox.app
ADMIN_PASSWORD=your_secure_admin_password

# Database URL: SQLite (default) or PostgreSQL
# For PostgreSQL: postgresql://smartbox_user:smartbox_password@db:5432/smartbox_db
DATABASE_URL=sqlite:///./smartbox.db

# Allowed CORS origins (comma-separated URLs for your deployed frontend apps)
CORS_ORIGINS=https://your-admin-panel.domain.com,https://your-agent-dashboard.domain.com,https://your-merchant-app.domain.com

# Frontend callback URL for OAuth
FRONTEND_URL=https://your-merchant-app.domain.com

# Optional Google OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
